{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "writing-commit-messages",
  "version": "0.1.2",
  "description": "Conventional Commits に準拠したコミットメッセージの規約",
  "author": {
    "name": "shutx"
  },
  "keywords": ["git", "commit", "commit-message", "conventional-commits"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Writing Commit Messages",
        "shortDescription": "Conventional Commits形式のコミットメッセージを書く",
        "developerName": "shutx",
        "category": "Productivity",
        "websiteURL": "https://github.com/shutx-net/skills",
        "defaultPrompt": ["現在の差分を確認し、Conventional Commits形式のコミットメッセージを作成してください。"],
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg"
      }
    }
  }
}
